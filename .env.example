SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Server-only. Use a private mainnet RPC endpoint in the deployment dashboard.
# Never use NEXT_PUBLIC for RPC credentials.
# Set ONLY if your reverse proxy overwrites this header and direct origin access is blocked.
# Allowed: x-forwarded-for, x-real-ip, cf-connecting-ip. Empty uses a shared bucket.
TRUST_PROXY_IP_HEADER=
